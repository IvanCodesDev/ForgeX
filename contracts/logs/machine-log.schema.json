{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IvanCodesDev/ForgeX/raw/main/contracts/logs/machine-log.schema.json",
  "title": "FORGE·X machine log",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "job", "telemetry"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "forgex-machine-log" },
    "version": { "const": 1 },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSec", "status"],
      "properties": {
        "jobId": { "type": "string" },
        "machineId": { "type": "string" },
        "firmware": { "type": "string" },
        "slicer": { "type": "string" },
        "gcodeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "durationSec": { "type": "number", "minimum": 0 },
        "filamentMm": { "type": "number", "minimum": 0 },
        "filamentG": { "type": "number", "minimum": 0 },
        "energyKwh": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "该任务的消耗电量 kWh；不是累计表读数。缺失保持未知，0 表示明确为零。"
        },
        "energyEvidence": {
          "type": "string",
          "maxLength": 500,
          "description": "计量设备、时间区间、读数差额及来源说明；参与成本对账时必须非空，系统不核实真实性。"
        },
        "completedLayers": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeSec"],
        "properties": {
          "timeSec": { "type": "number", "minimum": 0 },
          "nozzleC": { "type": "number" },
          "bedC": { "type": "number" }
        }
      }
    }
  }
}
