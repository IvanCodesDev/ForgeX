<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- V1 阶段后端刻意零外部包（仅 .NET 共享框架）。
       Stage 8.1（doc/FORGE-X优化开发手册 V2.0 §4.2）起：shares 迁 C# 需要首个
       PostgreSQL 访问层（Npgsql），故恢复 nuget.org；新增依赖仍需逐个评审并锁定版本。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
