# FORGE·X 智造洞察 — 后端环境变量（复制为 server/.env 并填写；.env 已被 .gitignore 排除）

# ── InfiniSynapse（仅服务端持有，绝不进前端 / 绝不提交仓库）──
INFINI_API_KEY=
INFINI_SERVER_URL=https://app.infinisynapse.cn
INFINI_CONSOLE_URL=https://api.infinisynapse.cn/api
# 端点核准通过后置 1，才会启用真实云端调用（防未经核准的接口进生产）
INFINI_VERIFIED=0
# 置 1 强制使用规则引擎（即使已配置 key）
INFINI_MOCK=0
# 上游任务超时（毫秒）。实测真实分析任务（96 行 CSV，多步 SQL 聚合）约 220s，默认留足余量
INFINI_TIMEOUT_MS=360000

# ── InfiniSynapse Partner SSO（路线 B）──
# 在 InfiniSynapse「设置 → 第三方接入」创建应用后填写；clientSecret 只放这里。
# 回调域名白名单需包含 PUBLIC_BASE 的 hostname。
INFINI_PARTNER_API=https://api.infinisynapse.cn/api
INFINI_PARTNER_CLIENT_ID=
INFINI_PARTNER_CLIENT_SECRET=
# 登录态有效期，默认 7 天（毫秒）。用户 Partner API Key 只保存在服务端会话中。
LOGIN_SESSION_TTL_MS=604800000

# ── 服务 ──
# 本机开发用 127.0.0.1；部署平台（Render/Fly/容器）需 0.0.0.0
HOST=127.0.0.1
PORT=8787
# 前后端分离部署时填前端域名（逗号分隔）；同源部署留空即可
ALLOW_ORIGINS=
# 经反向代理部署时置 1（限流将读取 X-Forwarded-For）
TRUST_PROXY=0
# 分享链接域名前缀，如 https://forgex.example.com；留空则用请求 Origin
PUBLIC_BASE=
# 同 IP 分析请求冷却（毫秒）
RATE_LIMIT_MS=5000
# 规则引擎每阶段的人造延时（毫秒）。默认 0：规则引擎本就是毫秒级完成，
# 拖慢进度条只是让它「看起来在思考」，属于欺骗性 UI。仅演示录屏需要时才调大。
MOCK_DELAY_MS=0
LOG_LEVEL=info

# ── C# G-code 权威计算 sidecar ─────────────────
# 仅填写 origin，不得附带路径、查询参数或用户名/密码；留空时同源代理返回结构化 503。
# 推荐 Node 与 C# 同机部署，生产可直接使用默认 C# 监听地址：
GCODE_AUTHORITY_URL=http://127.0.0.1:8788
# 端到端代理超时（毫秒）；请求体生产硬上限固定为 64 MiB。
GCODE_AUTHORITY_TIMEOUT_MS=120000
# 默认只允许 127.0.0.1 / localhost / ::1。确需独立远端 sidecar 时才显式置 1。
GCODE_AUTHORITY_ALLOW_REMOTE=0
# 异步作业路由独立回滚开关；0 时保留现有同步 /api/v1/gcode/analyze。
GCODE_ASYNC_JOBS_ENABLED=1

# ── 分析 provider 选择 ──────────────────────────
# auto（默认）：InfiniSynapse > OpenAI 兼容 > 本地规则引擎，按就绪程度自动选
# local        ：强制使用规则引擎（确定性统计 + 假设检验，无 AI，无外部计费）
# infinisynapse / openai：强制指定，配置不全时自动降级并在 /healthz 说明原因
ANALYSIS_PROVIDER=auto

# ── OpenAI 兼容端点（OpenAI / Azure / Ollama / vLLM / 各家兼容服务）──
# 任何暴露 /chat/completions 的服务都能接。留空则不启用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=120000

# ── 结果缓存 ────────────────────────────────────
# 同一「问题 + 数据集 + provider」不重复调用 AI。一次云端分析实测 160–230 秒且要花钱，
# 用户手滑点两次或刷新重问，不该产生第二次调用。
RESULT_CACHE_TTL_MS=1800000
RESULT_CACHE_MAX=200

# ── 持久化 ──────────────────────────────────────
# 数据源 / 分享页 / 知识库 / 用量计数的落盘位置。留空则退回纯内存（重启即丢）。
# 示例显式使用项目目录下的 data/，与默认行为保持一致。
DATA_DIR=./data

# ── 成本闸门（配了 AI 密钥后才有意义）────────────
# 一次 AI 分析实测 160–230 秒且按 token 计费。公开访问且配了密钥时，
# 这几项就是你的钱包护栏。规则引擎不受任何闸门限制——它不花钱。
AI_CONCURRENCY=2
AI_QUEUE_MAX=8
AI_DAILY_PER_CALLER=20
AI_DAILY_GLOBAL=200

# ── 鉴权（默认关闭；公网部署强烈建议开）──────────
# 配了 API_KEYS 后，带 key 的调用方按 key 计配额，其余按 IP。
# REQUIRE_AUTH=1 时未带合法 key 直接 401。
API_KEYS=
REQUIRE_AUTH=0

# P8 校准候选提交始终要求 API_KEYS 中的有效 key，即使 REQUIRE_AUTH=0。
# 队列读取与审核只接受 CALIBRATION_REVIEW_KEYS；普通/可分发 API key 不会继承审核权。
# 审核 key 可取 API_KEYS 的受信子集，也可由独立密钥系统保管。若与 API_KEYS 重叠，
# 同一 key 提交后仍会由存储层按匿名摘要执行四眼原则，禁止自审。
CALIBRATION_REVIEW_KEYS=
# 公开的 GET /api/calibrations 只返回已审核 active bundle，不需要 key。

# 启动时探活 AI provider，失败自动降级为规则引擎。置 0 关闭。
PROBE_PROVIDER=1
