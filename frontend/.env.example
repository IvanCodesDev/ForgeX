# 空值表示同源 API；填 offline 可强制离线演示。
VITE_API_BASE=
# 可选的 Node 客户端身份；Bearer 优先于 X-API-Key。VITE_* 会进入浏览器产物，
# 仅填写允许分发到目标客户端的凭据；不得填写校准审核密钥、C# sidecar 或上游 provider 密钥。
VITE_NODE_API_KEY=
VITE_NODE_BEARER=

# 1 启用 React 浏览器即时仿真预览；0 仅回退该路由并保留旧入口。
VITE_REACT_SIMULATOR_ENABLED=1
# 1 启用 React G-code 垂直切片；0 回退到迁移占位页/旧入口。
VITE_REACT_GCODE_ENABLED=1
# 1 启用本机 Profile 选择与社区 JSON 导入；0 回退到三个裸参数输入。
VITE_REACT_PROFILE_SELECTOR_ENABLED=1
# 1 启用 React 真机日志强摘要对账；0 仅回退该面板，保留 G-code 切片。
VITE_REACT_MACHINE_LOG_ENABLED=1
# 1 启用本地数据分析、图表与审计报告页面；0 隐藏该 React 路由。
VITE_REACT_ANALYTICS_ENABLED=1
# dotnet: C# 一致性校验通过后作为权威报告；shadow: 只比对不切换；browser: 一版发布周期内的 JS 回退。
VITE_ANALYTICS_AUTHORITY=dotnet
# 校准训练：browser 仅本地预览；shadow 双跑；dotnet 通过 /api/v1/calibration/train。
VITE_CALIBRATION_AUTHORITY=dotnet
# 1 启用公开校准目录、浏览器只读治理边界与已有分享查询；0 隐藏该 React 路由。
VITE_REACT_GOVERNANCE_ENABLED=1
# browser: 浏览器预览；shadow: 与 C# 双跑但不切主；dotnet: C# 权威模式。
VITE_GCODE_AUTHORITY=browser
# dotnet 模式默认使用可恢复的异步作业/SSE；0 回退到既有同步 analyze 接口。
VITE_GCODE_JOB_API=1
# G-code 始终提交给 Node；Node 再按 GCODE_AUTHORITY_URL 转发，并剥离浏览器认证头。
# 开发模式由 Vite 将 /api/v1/gcode 代理到 Node 的 127.0.0.1:8787。
