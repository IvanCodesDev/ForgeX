+check("compose-versioned-api-image", compose.includes("${FORGEX_API_IMAGE:-forgex-authority:local}"));
+
+const report = {
+  schemaVersion: "1.0",
+  generatedAtUtc: new Date().toISOString(),
+  result: "pass",
+  summary: { passed: checks.length, total: checks.length },
