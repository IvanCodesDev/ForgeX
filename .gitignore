# 密钥与本地环境（sk- key 只活在 server/.env，绝不入库）
server/.env
.env

node_modules/
.dotnet/
.dotnet-home/
.nuget-packages/
.tmp-dotnet-install.ps1
.dotnet-sdk-*.zip
*.log
Thumbs.db
.DS_Store

# IDE / 智能体配置（非项目代码，不入公开仓库）
.cursor/
.vscode/

# 冗余备份
*.bak

# 临时验证脚本（跑完即删，不入仓库）
.tmp-*
tests/.tmp-*

# 内部研发文档：优化开发手册、视觉校验记录、比赛策略与竞品分析。
# 属于研发过程记录而非面向使用者的说明，留在本地，不入公开仓库。
doc/

# 覆盖率与 E2E 产物
coverage/
.nyc_output/
test-results/
playwright-report/

# 文档渲染与本地迁移审计产物
_tmp_render*/
# 本地迁移、截图和验证证据包含绝对工作区路径，不进入公开源码仓库。
optimization/
dist/
frontend/dist/
*.tsbuildinfo
backend/**/bin/
backend/**/obj/
# CI 会重新生成并上传权威计算差异报告。
backend/artifacts/

# 运行时持久化数据（数据源 / 分享页 / 知识库 / 用量计数）
# 这是用户数据，不该进仓库；容器部署时挂卷到这里。
data/
.tmp-data-*/

# KC-Chat 运行时产物（插件自动生成，请勿入库）
.cursor/mcp.json
.cursor/kc-mcp/
.cursor/kc-mcp-messages/
.cursor/kc-chat-exports/
