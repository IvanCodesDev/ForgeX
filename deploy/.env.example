# Generate a deployment-only secret, for example:
#   openssl rand -base64 48
# Keep the same value on Node and the C# sidecar. Do not expose it to Vite.
GCODE_AUTHORITY_INTERNAL_SECRET=
GCODE_AUTHORITY_INTERNAL_SECRET_PREVIOUS=

# Bounded C# authority admission defaults; change only after a measured capacity gate.
GCODE_JOB_QUEUE_CAPACITY=64
GCODE_JOB_MAX_ACTIVE_PER_OWNER=4
GCODE_JOB_MAX_ACTIVE_PER_TENANT=16

# Immutable release tags make the image pair independently reversible.
FORGEX_NODE_IMAGE=forgex-insight:local
FORGEX_API_IMAGE=forgex-authority:local

# Business resources require PostgreSQL with migrations 0001..0006 applied.
# G-code jobs still use the C# /app/data volume (single-host topology).
PERSISTENCE_PROVIDER=postgres
POSTGRES_URL=
POSTGRES_POOL_MAX=10
POSTGRES_SSL=0

# Legacy gateway defaults to forwarding resources to the same C# PostgreSQL stores.
# Use the same POSTGRES_URL and API_KEYS for C# and the rollback gateway.
# Changing providers does not migrate existing file data; verify a migration before cut-over.
CSHARP_SHARES_PROVIDER=postgres
CSHARP_DATASOURCES_PROVIDER=postgres
CSHARP_KNOWLEDGE_PROVIDER=postgres
CSHARP_CALIBRATIONS_PROVIDER=postgres
SHARES_AUTHORITY=csharp
DATASOURCES_AUTHORITY=csharp
KNOWLEDGE_AUTHORITY=csharp
CALIBRATION_GOVERNANCE_AUTHORITY=csharp

# Public C# port and optional legacy-node rollback gateway port.
FORGEX_PORT=8787

FORGEX_LEGACY_PORT=8786
ANALYSIS_TASKS_AUTHORITY=csharp
API_KEYS=
CALIBRATION_REVIEW_KEYS=
REQUIRE_AUTH=0
# 共享布尔开关使用 0/1，确保 C# 与 Node 回滚入口保持相同语义。
TRUST_PROXY=0
ALLOW_ORIGINS=
PUBLIC_BASE=
FORGEX_ALLOWED_HOSTS=*
ANALYSIS_PROVIDER=auto
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
