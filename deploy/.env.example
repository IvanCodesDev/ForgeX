# Generate a deployment-only secret, for example:
#   openssl rand -base64 48
# Keep the same value on Node and the C# sidecar. Do not expose it to Vite.
GCODE_AUTHORITY_INTERNAL_SECRET=
GCODE_AUTHORITY_INTERNAL_SECRET_PREVIOUS=

# Bounded C# authority admission defaults; change only after a measured capacity gate.
GCODE_JOB_QUEUE_CAPACITY=64
GCODE_JOB_MAX_ACTIVE_PER_OWNER=4
GCODE_JOB_MAX_ACTIVE_PER_TENANT=16

# Immutable release tags make the image pair independently reversible.
FORGEX_NODE_IMAGE=forgex-insight:local
FORGEX_API_IMAGE=forgex-authority:local

# Shared persistence (leave file for the single-host fallback; postgres requires migrations and a managed URL).
PERSISTENCE_PROVIDER=file
POSTGRES_URL=
POSTGRES_POOL_MAX=10
POSTGRES_SSL=0

# Stage 8.6a resource authority cut-over (all default to the Node legs = no behaviour change).
# 1) Enable the C# storage leg first: file (under the authority /app/data volume) or postgres
#    (same POSTGRES_URL, same tables and RLS as Node). 2) Then flip the matching Node switch to csharp.
#    Rolling back is the reverse: switch back to node and restart; data stays in its own store.
CSHARP_SHARES_PROVIDER=disabled
CSHARP_DATASOURCES_PROVIDER=disabled
CSHARP_KNOWLEDGE_PROVIDER=disabled
CSHARP_CALIBRATIONS_PROVIDER=disabled
SHARES_AUTHORITY=node
DATASOURCES_AUTHORITY=node
KNOWLEDGE_AUTHORITY=node
CALIBRATION_GOVERNANCE_AUTHORITY=node

# Optional host port for the Node gateway.
FORGEX_PORT=8787
