# syntax=docker/dockerfile:1.7

FROM node:22.13.1-alpine3.21 AS frontend-build
WORKDIR /src
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
RUN npm ci --no-audit --no-fund
COPY frontend ./frontend
ENV VITE_GCODE_AUTHORITY=dotnet \
    VITE_MESH_AUTHORITY=dotnet \
    VITE_GCODE_JOB_API=1 \
    VITE_ANALYTICS_AUTHORITY=dotnet
RUN npm run frontend:build

FROM mcr.microsoft.com/dotnet/sdk:10.0.302-alpine3.23 AS build
WORKDIR /src
COPY global.json ./
COPY backend/Directory.Build.props backend/NuGet.Config ./backend/
COPY backend/src ./backend/src
RUN dotnet restore backend/src/ForgeX.Api/ForgeX.Api.csproj \
    --configfile backend/NuGet.Config \
    --disable-parallel \
    -m:1 \
    -nr:false
RUN dotnet publish backend/src/ForgeX.Api/ForgeX.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /out \
    -p:UseAppHost=false \
    -m:1 \
    -nr:false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.10-alpine3.23 AS runtime
WORKDIR /app
ENV Kestrel__Endpoints__Http__Url=http://0.0.0.0:8787 \
    AllowedHosts=* \
    StaticHosting__Enabled=true \
    StaticHosting__Root=/app/wwwroot \
    PublicFacade__Enabled=true \
    AnalysisTasks__Provider=postgres \
    Datasources__Provider=postgres \
    Knowledge__Provider=postgres \
    Shares__Provider=postgres \
    Calibrations__Provider=postgres \
    Storage__Root=/app/data \
    Persistence__Provider=file \
    DOTNET_EnableDiagnostics=0

RUN mkdir -p /app/data && chown -R 1654:1654 /app
COPY --from=build --chown=1654:1654 /out ./
COPY --chown=1654:1654 index.html README.md ./wwwroot/
COPY --chown=1654:1654 frontend/classic ./wwwroot/frontend/classic
COPY --chown=1654:1654 contracts ./wwwroot/contracts
COPY --from=frontend-build --chown=1654:1654 /src/dist/react ./wwwroot/dist/react

EXPOSE 8787
USER 1654:1654

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --output-document=/dev/null http://127.0.0.1:8787/healthz || exit 1

ENTRYPOINT ["dotnet", "ForgeX.Api.dll"]
